#!/bin/bash
if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

# Check the memory and choose the number of image threads; the rules are documented in
# docs/sysimage.md. This runs before anything else, so that a machine with too little memory
# fails right away.

# Stop if RAM + swap is not enough even for one image thread (measured peak about 26 GB, plus
# a few GB of margin). Only on Linux, where both are fixed; on Windows the pagefile and on
# macOS the swap can grow, which test/create_sys_image.jl takes into account.
if [[ "$OSTYPE" == linux* ]]; then
    _total_mb=$(awk '/^(MemTotal|SwapTotal):/ {s += $2} END {printf "%i", s / 1024}' /proc/meminfo)
    if [[ $_total_mb -lt 30720 ]]; then
        echo "Error: At least 30 GB of RAM + swap is needed to create a system image, but only $(( _total_mb / 1024 )) GB is available." >&2
        echo "Increase your swap file and retry." >&2
        exit 1
    fi
fi

# Physical memory in MB
totalmem=""
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
    echo "Checking system memory on Windows..."
    totalmem=$(powershell.exe -Command "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1MB" 2>/dev/null | awk '{printf "%i", $1}')
    limit_27gb=27000
    min_ram_mb=15000 min_ram_gb=15
elif [[ "$OSTYPE" == darwin* ]]; then
    echo "Checking system memory on macOS..."
    totalmem=$(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%i", $1 / 1000000}')
    limit_27gb=27000
    min_ram_mb=7000 min_ram_gb=7
else
    totalmem=$(grep MemTotal /proc/meminfo | awk '{printf "%i", $2 / 1024}')
    limit_27gb=26674
    min_ram_mb=15000 min_ram_gb=15
fi

# 15000 MB, because a 16 GB machine reports a little less than 16 GB; on macOS 7000 MB, so
# that Macs with 8 GB of RAM can build the image, swapping to the free disk space
if [[ -z "$totalmem" ]]; then
    echo "Warning: Could not determine the size of the RAM."
elif [[ $totalmem -lt $min_ram_mb ]]; then
    echo "Error: At least $min_ram_gb GB of RAM is needed to create a system image, but only $(( totalmem / 1024 )) GB is available." >&2
    exit 1
fi

# The build needs about 26 GB with one image thread and about 30 GB with two or more, so
# with less than 27 GB of RAM two threads are used (one with fewer than 4 CPU threads).
# test/create_sys_image.jl chooses the number of threads in all other cases; it uses one
# thread if RAM + swap is less than 34 GB, also if two were chosen here.
if [[ -n "${JULIA_IMAGE_THREADS:-}" ]]; then
    echo "JULIA_IMAGE_THREADS already set to $JULIA_IMAGE_THREADS, leaving as is"
elif [[ -z "$totalmem" ]]; then
    export JULIA_IMAGE_THREADS=1 SYSIMAGE_THREADS_AUTO=true
    echo "Using only one thread for sysimage compilation."
elif [[ $totalmem -lt $limit_27gb ]]; then
    _cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo "${NUMBER_OF_PROCESSORS:-2}")
    if [[ $_cpus -ge 4 ]]; then
        export JULIA_IMAGE_THREADS=2
    else
        export JULIA_IMAGE_THREADS=1
    fi
    export SYSIMAGE_THREADS_AUTO=true
    echo "Less than 27GB of memory detected. Using $JULIA_IMAGE_THREADS thread(s) for sysimage compilation."
fi

# Parse flags
_yes=false
for _arg in "$@"; do
    case "$_arg" in
        -y|--yes) _yes=true ;;
        *) echo "Unknown option: $_arg"; exit 1 ;;
    esac
done
# Also treat CI environments as non-interactive
if [[ "${CI:-}" == "true" ]]; then
    _yes=true
fi

export QT_QPA_PLATFORM=xcb
export KMP_DUPLICATE_LIB_OK=TRUE

if ! command -v juliaup &> /dev/null; then
    echo "Please install the Julia installer 'juliaup'!"
    echo "See: https://github.com/JuliaLang/juliaup"
    exit 1
fi

# Ask which Julia version to use, defaulting to the currently active version
if juliaup status 2>/dev/null | grep '^\s*\*' | grep -q '1\.13'; then
    _default_julia="1.13"
    _default_choice=2
else
    _default_julia="1.12"
    _default_choice=1
fi

if [[ "$_yes" == "true" ]]; then
    _julia_choice=""
    echo "Non-interactive mode: using Julia ${_default_julia}"
else
    echo "Which Julia version do you want to use?"
    echo "  1) Julia 1.12"
    echo "  2) Julia 1.13"
    read -rp "Enter 1 or 2 [default: ${_default_choice}]: " _julia_choice
fi
case "${_julia_choice}" in
    1) _desired_julia="1.12" ;;
    2) _desired_julia="1.13" ;;
    "") _desired_julia="${_default_julia}" ;;
    *) echo "Invalid choice. Exiting."; exit 1 ;;
esac
echo "Installing and activating Julia ${_desired_julia}..."
juliaup add "${_desired_julia}"
juliaup default "${_desired_julia}"
echo "Julia ${_desired_julia} is now the default."

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3} 
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4} 
fi

# Verify supported Julia versions (1.12 or 1.13)
if [[ "$julia_major" != "1.12" && "$julia_major" != "1.13" ]]; then
    echo "Warning: Unsupported Julia version detected: $julia_version. This script supports Julia 1.12 or 1.13 only." >&2
    echo "Use the command 'juliaup default 1.12' or 'juliaup default 1.13' to switch to a supported version." >&2
    exit 1
fi

if test -f "bin/kps-image-${julia_major}.so"; then
    mv bin/kps-image-${julia_major}.so bin/kps-image-${julia_major}.so.bak
fi

restore_backup() {
    if test -f "bin/kps-image-${julia_major}.so.bak"; then
        echo "Restoring the previous system image."
        mv bin/kps-image-${julia_major}.so.bak bin/kps-image-${julia_major}.so
    fi
}

echo "Updating packages..."
if test -f "Manifest.toml"; then
   rm Manifest.toml
fi
# Bring the environment into a usable state before anything expensive happens. The rungs
# escalate: use the manifest as it is; `Pkg.resolve()` repairs one that no longer satisfies
# the projects (changed compat, a new Julia version); discarding the manifest and running
# `Pkg.update()` is the last resort. The latter two move package versions, which invalidates
# the precompile caches of the whole environment, so they say so -- the full precompile that
# follows is then a consequence, not wasted work.
# (`read -d ''` always ends at EOF with status 1; the `|| true` keeps that benign.)
_instantiate_jl=""
read -r -d '' _instantiate_jl <<'JLEOF' || true
using Pkg
# `Pkg.instantiate()` only *warns* when the manifest no longer matches the projects, so
# the out-of-sync case has to be detected explicitly instead of caught as an exception.
try
    if Pkg.is_manifest_current(Pkg.Types.Context()) === false
        @info "Manifest is out of sync with the project; resolving..."
        Pkg.resolve()
        @info "Manifest repaired by resolve; package versions moved, so a full precompile follows."
    end
    Pkg.instantiate()
catch e
    @warn "Could not instantiate the project, discarding the manifest..." exception=e
    # Delete the manifest Pkg actually uses: with the root `[workspace]` section that is
    # the shared `Manifest-v<version>.toml` at the top of the repository, not a file next
    # to the active Project.toml.
    mfile = Pkg.Types.Context().env.manifest_file
    if mfile !== nothing && isfile(mfile)
        rm(mfile; force=true)
        @info "Deleted $(basename(mfile))"
    end
    Pkg.update()
    @info "Manifest rebuilt from scratch; a full precompile follows."
end
JLEOF

if ! julia --startup-file=no --project=test -e "$_instantiate_jl"; then
    echo "Could not instantiate the test project." >&2
    restore_backup
    exit 1
fi

if ! julia --startup-file=no --project=test -t auto -e "using Pkg; Pkg.precompile()"; then
    echo "Precompiling the test project failed." >&2
    restore_backup
    exit 1
fi

if ! julia --startup-file=no --project=test -t auto -e "include(\"./test/create_sys_image.jl\");"; then
    echo "Building the system image failed." >&2
    restore_backup
    exit 1
fi

mv kps-image_tmp.so bin/kps-image-${julia_major}.so
if ! julia --startup-file=no --project=examples -J bin/kps-image-${julia_major}.so -e "using Pkg; Pkg.precompile(); using Parameters"; then
    echo "The new system image cannot be loaded; removing it." >&2
    rm -f bin/kps-image-${julia_major}.so
    restore_backup
    exit 1
fi

# Workaround for https://github.com/kahliburke/Kaimon.jl/issues/104: if KaimonGate is in the
# global environment, precompile it and its dependency ZMQ for the new system image now. Loaded
# later from startup.jl with --project, ZMQ would be compiled inside KaimonGate's precompile
# process, which segfaults with a custom system image.
if ! julia --startup-file=no --project=@v${julia_major} -J bin/kps-image-${julia_major}.so -e 'if Base.identify_package("KaimonGate") !== nothing
        using Pkg; Pkg.precompile("KaimonGate")
    end'; then
    echo "Warning: Precompiling KaimonGate failed." >&2
fi

# If Revise is in the global environment, precompile it and its extension DistributedExt for
# the new system image now, so that loading it from startup.jl does not compile it first.
# Loading Distributed together with Revise triggers the compilation of the extension.
if ! julia --startup-file=no --project=@v${julia_major} -J bin/kps-image-${julia_major}.so -e 'if Base.identify_package("Revise") !== nothing
        using Pkg; Pkg.precompile("Revise")
        using Distributed, Revise
    end'; then
    echo "Warning: Precompiling Revise failed." >&2
fi

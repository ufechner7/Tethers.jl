#!/bin/bash
# Create a system image for faster startup of the examples. This variant is used when
# `Tethers` was installed with the package manager and the examples were installed with
# `install_examples()`; `copy_bin()` installs it as `bin/create_sys_image`.
#
# Unlike the script of the same name in a clone of the Tethers.jl repository, this script
# uses the project that is active in the current working directory, not the `test` project
# of the repository, and it does not change the default Julia version with `juliaup`.
#
# Usage:
#   ./bin/create_sys_image             # use the existing manifest
#   ./bin/create_sys_image --update    # update all packages first

update=false
if [[ $# -gt 0 ]]; then
    if [[ $1 != "--update" ]]; then
        echo "Invalid parameter! Use:"
        echo "./bin/create_sys_image"
        echo "or"
        echo "./bin/create_sys_image --update"
        exit 1
    else
        update=true
    fi
fi

if [[ $(basename $(pwd)) == "bin" ]]; then
    cd ..
fi

export QT_QPA_PLATFORM=xcb
export KMP_DUPLICATE_LIB_OK=TRUE

julia_version=$(julia --version | awk '{print($3)}')
julia_major=${julia_version:0:3}
if [[ $julia_major == "1.1" ]]; then
    julia_major=${julia_version:0:4}
fi

# Verify supported Julia versions (1.11, 1.12 or 1.13)
if [[ "$julia_major" != "1.11" && "$julia_major" != "1.12" && "$julia_major" != "1.13" ]]; then
    echo "Warning: Unsupported Julia version detected: $julia_version. This script supports Julia 1.11, 1.12 or 1.13 only." >&2
    echo "Use the command 'juliaup default 1.11', 'juliaup default 1.12' or 'juliaup default 1.13' to switch to a supported version." >&2
    exit 1
fi

# Check memory and limit threads if needed
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
    # Windows: use wmic or PowerShell
    echo "Checking system memory on Windows..."
    totalmem=$(powershell.exe -Command "(Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory / 1MB" 2>/dev/null | awk '{printf "%i", $1}')
    if [[ -z "$totalmem" || $totalmem -lt 27000 ]]; then
        echo "Warning: Less than 27GB of memory detected on Windows. Using only one thread for sysimage compilation."
        export JULIA_IMAGE_THREADS=1
    fi
elif [[ "$OSTYPE" == darwin* ]]; then
    # macOS: use sysctl
    echo "Checking system memory on macOS..."
    totalmem=$(sysctl -n hw.memsize 2>/dev/null | awk '{printf "%i", $1 / 1000000}')
    if [[ -z "$totalmem" || $totalmem -lt 27000 ]]; then
        echo "Warning: Less than 27GB of memory detected on macOS. Using only one thread for sysimage compilation."
        export JULIA_IMAGE_THREADS=1
    fi
else
    # Linux: use /proc/meminfo
    totalmem=$(grep MemTotal /proc/meminfo | awk '{printf "%i", $2 / 1024}')
    if [[ $totalmem -lt 26674 ]]; then
        echo "Warning: Less than 27GB of memory detected. Using only one thread for sysimage compilation."
        export JULIA_IMAGE_THREADS=1
    fi
fi

# Size the GC heap hint for the sysimage build. The build needs roughly 26GB of resident
# memory; hinting far below that only makes the GC run full collections it cannot profit
# from (measured on a 30GB machine: 8000M -> 742s, 16000M -> 569s, 24000M -> 585s, at an
# unchanged peak RSS). Half of the physical memory is close to the optimum.
heap_hint=8000
if [[ -n "$totalmem" && $totalmem -gt 16000 ]]; then
    heap_hint=$(( totalmem / 2 ))
fi
echo "Using --heap-size-hint=${heap_hint}M for the sysimage build."

if test -f "bin/kps-image-${julia_major}.so"; then
    mv bin/kps-image-${julia_major}.so bin/kps-image-${julia_major}.so.bak
fi

restore_backup() {
    if test -f "bin/kps-image-${julia_major}.so.bak"; then
        echo "Restoring the previous system image."
        mv bin/kps-image-${julia_major}.so.bak bin/kps-image-${julia_major}.so
    fi
}

# Bring the environment into a usable state before anything expensive happens. The rungs
# escalate: use the manifest as it is; `Pkg.resolve()` repairs one that no longer satisfies
# the projects (changed compat, a new Julia version); discarding the manifest and running
# `Pkg.update()` is the last resort. The latter two move package versions, which invalidates
# the precompile caches of the whole environment, so they say so -- the full precompile that
# follows is then a consequence, not wasted work.
# (`read -d ''` always ends at EOF with status 1; the `|| true` keeps that benign.)
_instantiate_jl=""
read -r -d '' _instantiate_jl <<'JLEOF' || true
using Pkg
# `Pkg.instantiate()` only *warns* when the manifest no longer matches the projects, so
# the out-of-sync case has to be detected explicitly instead of caught as an exception.
try
    if Pkg.is_manifest_current(Pkg.Types.Context()) === false
        @info "Manifest is out of sync with the project; resolving..."
        Pkg.resolve()
        @info "Manifest repaired by resolve; package versions moved, so a full precompile follows."
    end
    Pkg.instantiate()
catch e
    @warn "Could not instantiate the project, discarding the manifest..." exception=e
    # Delete the manifest Pkg actually uses: with the root `[workspace]` section that is
    # the shared `Manifest-v<version>.toml` at the top of the repository, not a file next
    # to the active Project.toml.
    mfile = Pkg.Types.Context().env.manifest_file
    if mfile !== nothing && isfile(mfile)
        rm(mfile; force=true)
        @info "Deleted $(basename(mfile))"
    end
    Pkg.update()
    @info "Manifest rebuilt from scratch; a full precompile follows."
end
JLEOF

if [[ $update == true ]]; then
    echo "Updating packages..."
    if ! julia --startup-file=no --project -e "using Pkg; Pkg.update()"; then
        echo "Updating the packages failed." >&2
        restore_backup
        exit 1
    fi
else
    echo "Using existing manifest file!"
    if ! julia --startup-file=no --project -e "$_instantiate_jl"; then
        echo "Could not instantiate the project." >&2
        restore_backup
        exit 1
    fi
fi

if ! julia --startup-file=no --project -t auto -e "using Pkg; Pkg.precompile()"; then
    echo "Precompiling the project failed." >&2
    restore_backup
    exit 1
fi

if ! julia --startup-file=no --project -t auto --heap-size-hint=${heap_hint}M -e "include(\"./test/create_sys_image.jl\");"; then
    echo "Building the system image failed." >&2
    restore_backup
    exit 1
fi

mv kps-image_tmp.so bin/kps-image-${julia_major}.so
if ! julia --startup-file=no --project -J bin/kps-image-${julia_major}.so -e "using Pkg; Pkg.precompile()"; then
    echo "The new system image cannot be loaded; removing it." >&2
    rm -f bin/kps-image-${julia_major}.so
    restore_backup
    exit 1
fi
